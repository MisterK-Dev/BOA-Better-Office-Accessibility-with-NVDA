s2">"time_app_mod"</span><span class=3D"p">)</span>

	<span class=3D"k">def</span><span class=3D"w"> </span><span class=3D"nf">t=
erminate</span><span class=3D"p">(</span><span class=3D"bp">self</span><spa=
n class=3D"p">,</span> <span class=3D"o">*</span><span class=3D"n">args</sp=
