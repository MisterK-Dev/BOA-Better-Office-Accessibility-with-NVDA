ift+v"</span><span class=3D"p">)</span>
	<span class=3D"k">def</span><span class=3D"w"> </span><span class=3D"nf">s=
cript_announceNVDAVersion</span><span class=3D"p">(</span><span class=3D"bp=
">self</span><span class=3D"p">,</span> <span class=3D"n">gesture</span><sp=
an class=3D"p">):</span>
		<span class=3D"n">ui</span><span class=3D"o">.</span><span class=3D"n">me=
ssage</span><span class=3D"p">(</span><span class=3D"n">buildVersion</span>=
<span class=3D"o">.</span><span class=3D"n">version</span><span class=3D"p"=
