#. Consideration: Excel uses the `xlFormatConditionType` enum to classify
#. rules.
#. Each rule type requires accessing completely different COM properties
#. (e.g., `xlColorScale`
#. uses `ColorScaleCriteria`, while `xlCellValue` uses `Operator` and
#. `Formula1`).
#. Mapping of common xlFormatConditionType values:
#: addon\boa_lib\excel_enhancements\conditional_formatting.py:177
msgid "Rule"
msgstr "규칙"

#: addon\boa_lib\excel_enhancements\conditional_formatting.py:180
msgid "Between"
msgstr "다음 값의 사이에 있음"

#: addon\boa_lib\excel_enhancements\conditional_formatting.py:180
msgid "Not Between"
msgstr "다음 값의 사이에 없음"

#: addon\boa_lib\excel_enhancements\conditional_formatting.py:180
msgid "Equal to"
msgstr "다음 값과 같음"

#: addon\boa_lib\excel_enhancements\conditional_formatting.py:180
msgid "Not Equal to"
msgstr "다음 값과 같지 않음"

#: addon\boa_lib\excel_enhancements\conditional_formatting.py:180
msgid "Greater than"
msgstr "다음 값보다 큼"

#: addon\boa_lib\excel_enhancements\conditional_formatting.py:180
msgid "Less than"
msgstr "다음 값보다 작음"

#: addon\boa_lib\excel_enhancements\conditional_formatting.py:180
msgid "Greater than or equal to"
msgstr "다음 값보다 크거나 같음"

#: addon\boa_lib\excel_enhancements\conditional_formatting.py:180
