msgid ""
"{loc}: 3 or more consecutive blank lines detected. Use a Page Break instead."
msgstr ""
"{loc}: 3 ਜਾਂ ਵੱਧ ਲਗਾਤਾਰ ਖਾਲੀ ਲਾਈਨਾਂ ਮਿਲੀਆਂ ਹਨ। ਇਸ ਦੀ ਬਜਾਏ ਪੇਜ ਬ੍ਰੇਕ ਦੀ ਵਰਤੋਂ"
" ਕਰੋ।"

msgid "{loc}: Empty heading detected."
msgstr "{loc}: ਖਾਲੀ ਸਿਰਲੇਖ ਮਿਲਿਆ ਹੈ।"

msgid ""
"{loc}: Manual line break (Shift+Enter) detected inside paragraph. This "
"breaks screen reader flow."
msgstr ""
"{loc}: ਪੈਰੇ ਦੇ ਅੰਦਰ ਮੈਨੂਅਲ ਲਾਈਨ ਬ੍ਰੇਕ (Shift+Enter) ਮਿਲਿਆ ਹੈ। ਇਹ ਸਕ੍ਰੀਨ ਰੀਡਰ"
" ਦੇ ਪ੍ਰਵਾਹ ਨੂੰ ਤੋੜਦਾ ਹੈ।"

msgid ""
"{loc}: Spacebar indent detected (4+ spaces). Use Tab or Paragraph Indent."
msgstr ""
"{loc}: ਸਪੇਸਬਾਰ ਇੰਡੈਂਟ ਮਿਲਿਆ ਹੈ (4+ ਸਪੇਸ)। ਟੈਬ ਜਾਂ ਪੈਰਾਗ੍ਰਾਫ ਇੰਡੈਂਟ ਦੀ ਵਰਤੋਂ "
"ਕਰੋ।"

msgid ""
"{loc}: Multiple consecutive Tab characters detected. Use Center/Right "
"alignment or Ruler Indents."
msgstr ""
"{loc}: ਲਗਾਤਾਰ ਕਈ ਟੈਬ ਅੱਖਰ ਮਿਲੇ ਹਨ। ਕੇਂਦਰ/ਸੱਜੇ ਅਲਾਈਨਮੈਂਟ ਜਾਂ ਰੂਲਰ ਇੰਡੈਂਟ ਦੀ "
"ਵਰਤੋਂ ਕਰੋ।"

msgid "{loc}: Inconsistent font sizes detected within the same paragraph."
msgstr "{loc}: ਇੱਕੋ ਪੈਰੇ ਦੇ ਅੰਦਰ ਅਸੰਗਤ ਫੌਂਟ ਆਕਾਰ ਮਿਲੇ ਹਨ।"

msgid "{loc}: Inconsistent font types detected within the same paragraph."
msgstr "{loc}: ਇੱਕੋ ਪੈਰੇ ਦੇ ਅੰਦਰ ਅਸੰਗਤ ਫੌਂਟ ਕਿਸਮਾਂ ਮਿਲੀਆਂ ਹਨ।"

msgid "{loc}: Highlighted text detected."
msgstr "{loc}: ਹਾਈਲਾਈਟ ਕੀਤਾ ਟੈਕਸਟ ਮਿਲਿਆ ਹੈ।"

msgid ""
"{loc}: Fake list detected. Manual numbering used instead of built-in list."
msgstr ""
"{loc}: ਨਕਲੀ ਸੂਚੀ ਮਿਲੀ ਹੈ। ਬਿਲਟ-ਇਨ ਸੂਚੀ ਦੀ ਬਜਾਏ ਮੈਨੂਅਲ ਨੰਬਰਿੰਗ ਦੀ ਵਰਤੋਂ ਕੀਤੀ "
"ਗਈ ਹੈ।"

msgid ""
"{loc}: Skipped heading level (Jumped from Level {old} directly to Level "
"{new})."
msgstr ""
"{loc}: ਸਿਰਲੇਖ ਦਾ ਪੱਧਰ ਛੱਡਿਆ ਗਿਆ (ਪੱਧਰ {old} ਤੋਂ ਸਿੱਧਾ ਪੱਧਰ {new} 'ਤੇ ਚਲੇ "
"ਗਏ)।"

msgid ""
"{loc}: Table contains merged or split cells. This breaks screen reader grid "
"navigation."
msgstr ""
"{loc}: ਟੇਬਲ ਵਿੱਚ ਮਿਲਾਏ ਜਾਂ ਵੱਖ ਕੀਤੇ ਸੈੱਲ ਹਨ। ਇਹ ਸਕ੍ਰੀਨ ਰੀਡਰ ਦੇ ਗਰਿੱਡ "
"ਨੈਵੀਗੇਸ਼ਨ ਨੂੰ ਤੋੜਦਾ ਹੈ।"

msgid ""
"{loc}: Table is missing 'Repeat Header Rows'. Data will be unreadable on "
"subsequent pages."
msgstr ""
"{loc}: ਟੇਬਲ ਵਿੱਚ 'Repeat Header Rows' (ਹੈਡਰ ਰੋਅ ਦੁਹਰਾਓ) ਮੌਜੂਦ ਨਹੀਂ ਹੈ। ਅਗਲੇ "
"ਪੰਨਿਆਂ 'ਤੇ ਡਾਟਾ ਪੜ੍ਹਨਯੋਗ ਨਹੀਂ ਹੋਵੇਗਾ।"

msgid ""
"<h2>Format & Accessibility Audit Complete</h2><p>No formatting "
"inconsistencies found! The document looks clean.</p>"
msgstr ""
"<h2>ਫਾਰਮੈਟ ਅਤੇ ਪਹੁੰਚਯੋਗਤਾ ਆਡਿਟ ਪੂਰਾ ਹੋਇਆ</h2><p>ਕੋਈ ਫਾਰਮੈਟਿੰਗ ਅਸੰਗਤਤਾ ਨਹੀਂ "
"ਮਿਲੀ! ਦਸਤਾਵੇਜ਼ ਸਾਫ਼ ਲੱਗ ਰਿਹਾ ਹੈ।</p>"

msgid "Format Audit Results"
msgstr "ਫਾਰਮੈਟ ਆਡਿਟ ਦੇ ਨਤੀਜੇ"

msgid "Format & Accessibility Audit Report"
msgstr "ਫਾਰਮੈਟ ਅਤੇ ਪਹੁੰਚਯੋਗਤਾ ਆਡਿਟ ਰਿਪੋਰਟ"

