#. Title for the NVDA settings dialog list and the panel title
#: addon\boa_lib\boa_gui.py:33
msgid "BOA Office Enhancements"
msgstr "BOA Office மேம்பாடுகள்"

#: addon\boa_lib\boa_gui.py:65 addon\boa_lib\boa_gui.py:85
msgid "Off"
msgstr "முடக்கு"

#: addon\boa_lib\boa_gui.py:65
msgid "One-time Announcement"
msgstr "ஒருமுறை அறிவிப்பு"

#: addon\boa_lib\boa_gui.py:65
msgid "Guided Announcement"
msgstr "வழிகாட்டப்பட்ட அறிவிப்பு"

#: addon\boa_lib\boa_gui.py:85
msgid "Strict Memory Check (CountA)"
msgstr "கண்டிப்பான நினைவக சரிபார்ப்பு (CountA)"

#: addon\boa_lib\boa_gui.py:85
msgid "Visible Data Only (Math Engine)"
msgstr "புலப்படும் தரவு மட்டும் (Math Engine)"

#: addon\boa_lib\boa_gui.py:95
msgid "Select the engine used to detect the end of data in a row or column."
msgstr ""
"ஒரு வரிசை அல்லது நெடுவரிசையில் தரவின் முடிவைக் கண்டறியப் பயன்படும் இன்ஜினைத்"
" தேர்ந்தெடுக்கவும்."

#: addon\boa_lib\boa_gui.py:109
msgid "&Excel: Enable Bulk Sheet Organizer and Quick Sheet Mover"
msgstr ""
"&Excel: Bulk Sheet Organizer மற்றும் Quick Sheet Mover ஆகியவற்றை இயக்கு"

#: addon\boa_lib\boa_gui.py:110
msgid "Use accessible Sheet &Rename dialog instead of native edit field"
msgstr ""
"நேட்டிவ் எடிட் புலத்திற்குப் பதிலாக அணுகக்கூடிய தாள் மறுபெயரிடு (&R) "
"உரையாடலைப் பயன்படுத்தவும்"

#: addon\boa_lib\boa_gui.py:111
msgid "Prevent NVDA &crashes in Excel text fields"
msgstr "Excel உரைப் புலங்களில் NVDA செயலிழப்பதைத் தடு (&c)"

#: addon\boa_lib\boa_gui.py:112
msgid "Announce when a m&ulti-cell selection is unexpectedly lost"
msgstr "பல-கலத் தேர்வு எதிர்பாராத விதமாக இழக்கப்படும்போது அறிவிக்கவும் (&u)"

#: addon\boa_lib\boa_gui.py:113
msgid "Proactively announce when navigating past &hidden rows or columns"
msgstr ""
"மறைக்கப்பட்ட வரிசைகள் அல்லது நெடுவரிசைகளைக் கடந்து செல்லும் போது "
"முன்கூட்டியே அறிவிக்கவும் (&h)"

#: addon\boa_lib\boa_gui.py:114
msgid "Enable Sheet &Layout Analyzer via NVDA+E, L"
msgstr "NVDA+E, L மூலம் Sheet &Layout Analyzer ஐ இயக்கு"

#: addon\boa_lib\boa_gui.py:115
msgid "Sheet Layout Auto-Announce &Mode:"
msgstr "தாள் லேஅவுட் தானியங்கு-அறிவிப்பு பயன்முறை (&M):"

#: addon\boa_lib\boa_gui.py:116
msgid "Conditional &Formatting and color"
msgstr "நிபந்தனை வடிவமைப்பு மற்றும் நிறம் (&F)"

#: addon\boa_lib\boa_gui.py:117
msgid "Enable Cell Moni&tor (slots 1-9 and continuous background monitoring)"
msgstr ""
"கலக் கண்காணிப்பியை இயக்கு (ஸ்லாட்டுகள் 1-9 மற்றும் தொடர்ச்சியான பின்னணி "
"கண்காணிப்பு) (&t)"

#: addon\boa_lib\boa_gui.py:118
msgid ""
"Announce when there is no more data in the direction you are &navigating"
msgstr "நீங்கள் செல்லும் திசையில் வேறு தரவு இல்லாதபோது அறிவிக்கவும் (&n)"

#: addon\boa_lib\boa_gui.py:120
msgid "Excel Enhancements"
msgstr "Excel மேம்பாடுகள்"

#: addon\boa_lib\boa_gui.py:124
msgid ""
"&PowerPoint: Read hidden Hex codes when navigating the Standard Color "
"hexagon grid"
msgstr ""
"&PowerPoint: ஸ்டாண்டர்ட் கலர் அறுகோண கட்டத்தில் செல்லும்போது மறைக்கப்பட்ட "
"Hex குறியீடுகளைப் படிக்கவும்"

#: addon\boa_lib\boa_gui.py:125
msgid "Ensure the He&x Color edit field is properly labeled"
msgstr "He&x வண்ண திருத்து புலம் சரியாக லேபிளிடப்பட்டுள்ளதை உறுதிசெய்யவும்"

#: addon\boa_lib\boa_gui.py:126
msgid "Ensure the R&GB Color edit fields are properly labeled"
msgstr "R&GB வண்ண திருத்து புலங்கள் சரியாக லேபிளிடப்பட்டுள்ளதை உறுதிசெய்யவும்"

#: addon\boa_lib\boa_gui.py:127
msgid "Prevent NVDA cr&ashes in PowerPoint text fields"
msgstr "PowerPoint உரைப் புலங்களில் NVDA செயலிழப்பதைத் தடு (&a)"

#: addon\boa_lib\boa_gui.py:129
msgid "PowerPoint Enhancements"
msgstr "PowerPoint மேம்பாடுகள்"

#: addon\boa_lib\boa_gui.py:133
msgid "&Word: Prevent NVDA crashes in Word text fields"
msgstr "&Word: Word உரைப் புலங்களில் NVDA செயலிழப்பதைத் தடு"

#: addon\boa_lib\boa_gui.py:135
msgid "Word Enhancements"
msgstr "Word மேம்பாடுகள்"

#: addon\boa_lib\excel_enhancements\accessible_rename.py:85
#, python-brace-format
msgid "Renaming to {name}"
msgstr "{name} என மறுபெயரிடப்படுகிறது"

#: addon\boa_lib\excel_enhancements\bulk_sheet_organizer.py:106
msgid "Bulk arrangement complete"
msgstr "மொத்த ஏற்பாடு முடிந்தது"

#: addon\boa_lib\excel_enhancements\bulk_sheet_organizer.py:108
#, python-brace-format
msgid "Error during bulk move: {error}"
msgstr "மொத்தமாக நகர்த்தும்போது பிழை: {error}"

#: addon\boa_lib\excel_enhancements\bulk_sheet_organizer.py:150
msgid "Could not find Excel grid."
msgstr "Excel கட்டத்தைக் கண்டறிய முடியவில்லை."

#: addon\boa_lib\excel_enhancements\bulk_sheet_organizer.py:158
msgid "Failed to hook Excel."
msgstr "Excel உடன் இணைக்க முடியவில்லை."

#: addon\boa_lib\excel_enhancements\bulk_sheet_organizer.py:165
msgid "No active workbook."
msgstr "செயலில் உள்ள பணிப்புத்தகம் இல்லை."

#: addon\boa_lib\excel_enhancements\bulk_sheet_organizer.py:175
msgid "Error opening organizer"
msgstr "ஆர்கனைசரை திறப்பதில் பிழை"

#: addon\boa_lib\excel_enhancements\bulk_sheet_organizer.py:271
#, python-brace-format
msgid "Scheduled: {sheet} to position {pos}"
msgstr "திட்டமிடப்பட்டது: {sheet} நிலை {pos} க்கு"

#: addon\boa_lib\excel_enhancements\bulk_sheet_organizer.py:289
msgid "Move removed"
msgstr "நகர்த்தல் அகற்றப்பட்டது"

#: addon\boa_lib\excel_enhancements\cell_monitor.py:119
#: addon\boa_lib\excel_enhancements\cell_monitor.py:231
msgid "Error: Could not read Excel cell."
msgstr "பிழை: Excel கலத்தைப் படிக்க முடியவில்லை."

#: addon\boa_lib\excel_enhancements\cell_monitor.py:144
#, python-brace-format
msgid "{old_cell} has been replaced by {address} for slot {slot_str}"
msgstr ""
"ஸ்லாட் {slot_str} க்கு {old_cell} ஆனது {address} ஆல் மாற்றப்பட்டுள்ளது"

#: addon\boa_lib\excel_enhancements\cell_monitor.py:147
#, python-brace-format
msgid "{address} set to slot {slot_str}"
msgstr "{address} ஸ்லாட் {slot_str} க்கு அமைக்கப்பட்டது"

#: addon\boa_lib\excel_enhancements\cell_monitor.py:159
#, python-brace-format
msgid "Slot {slot_str} is empty."
msgstr "ஸ்லாட் {slot_str} காலியாக உள்ளது."

#: addon\boa_lib\excel_enhancements\cell_monitor.py:169
msgid "Error: Excel not accessible."
msgstr "பிழை: Excel ஐ அணுக முடியவில்லை."

#: addon\boa_lib\excel_enhancements\cell_monitor.py:176
#, python-brace-format
msgid "Slot {slot_str} lost. Workbook '{wb}' was renamed or closed."
msgstr ""
"ஸ்லாட் {slot_str} இழக்கப்பட்டது. பணிப்புத்தகம் '{wb}' மறுபெயரிடப்பட்டது "
"அல்லது மூடப்பட்டது."

#: addon\boa_lib\excel_enhancements\cell_monitor.py:189
#, python-brace-format
msgid "Slot {slot_str} lost. Sheet '{sheet}' was renamed or deleted."
msgstr ""
"ஸ்லாட் {slot_str} இழக்கப்பட்டது. தாள் '{sheet}' மறுபெயரிடப்பட்டது அல்லது "
"நீக்கப்பட்டது."

#: addon\boa_lib\excel_enhancements\cell_monitor.py:214
#, python-brace-format
msgid "{val} - {cell}{location_str}"
msgstr "{val} - {cell}{location_str}"

#: addon\boa_lib\excel_enhancements\cell_monitor.py:217
#, python-brace-format
msgid "Cannot read slot {slot_str}. Excel may be busy."
msgstr "ஸ்லாட் {slot_str} ஐப் படிக்க முடியவில்லை. Excel பிஸியாக இருக்கலாம்."

#: addon\boa_lib\excel_enhancements\cell_monitor.py:238
#, python-brace-format
msgid "Continuous monitor OFF for {address}"
msgstr "{address} க்கான தொடர்ச்சியான கண்காணிப்பு முடக்கப்பட்டுள்ளது"

#: addon\boa_lib\excel_enhancements\cell_monitor.py:244
#, python-brace-format
msgid "Continuous monitor ON for {address}"
msgstr "{address} க்கான தொடர்ச்சியான கண்காணிப்பு இயக்கப்பட்டுள்ளது"

#: addon\boa_lib\excel_enhancements\cell_monitor.py:258
msgid "All monitored and slotted cells cleared."
msgstr ""
"கண்காணிக்கப்படும் மற்றும் ஸ்லாட் செய்யப்பட்ட அனைத்து கலங்களும் "
"அழிக்கப்பட்டன."

#: addon\boa_lib\excel_enhancements\cell_monitor.py:361
#, python-brace-format
msgid "{cell_addr} updated: {current_val}{location_str}"
msgstr "{cell_addr} புதுப்பிக்கப்பட்டது: {current_val}{location_str}"

#: addon\boa_lib\excel_enhancements\cell_monitor.py:379
#, python-brace-format
msgid "Monitor for Slot {slot_cleared} lost due to name change or closure."
msgstr ""
"பெயர் மாற்றம் அல்லது மூடல் காரணமாக ஸ்லாட் {slot_cleared} க்கான கண்காணிப்பு "
"இழக்கப்பட்டது."

#: addon\boa_lib\excel_enhancements\cell_monitor.py:382
#, python-brace-format
msgid "Monitor cleared: {sheet_closed} in {wb_closed} lost."
msgstr ""
"கண்காணிப்பு அழிக்கப்பட்டது: {wb_closed} இல் உள்ள {sheet_closed} "
"இழக்கப்பட்டது."

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:116
msgid "unselected"
msgstr "தேர்வுநீக்கப்பட்டது"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:210
#, python-brace-format
msgid "{address} selected"
msgstr "{address} தேர்ந்தெடுக்கப்பட்டது"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:336
#, python-brace-format
msgid "Row {row_num} hidden"
msgstr "வரிசை {row_num} மறைக்கப்பட்டுள்ளது"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:339
#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:341
#, python-brace-format
msgid "Rows {start} through {end} hidden"
msgstr "வரிசைகள் {start} முதல் {end} வரை மறைக்கப்பட்டுள்ளன"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:343
msgid "Crossed heavily fragmented hidden rows"
msgstr "அதிகமாக துண்டாக்கப்பட்ட மறைக்கப்பட்ட வரிசைகள் கடக்கப்பட்டன"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:406
#, python-brace-format
msgid "Column {col_letter} hidden"
msgstr "நெடுவரிசை {col_letter} மறைக்கப்பட்டுள்ளது"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:409
#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:411
#, python-brace-format
msgid "Columns {start} through {end} hidden"
msgstr "நெடுவரிசைகள் {start} முதல் {end} வரை மறைக்கப்பட்டுள்ளன"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:413
msgid "Crossed heavily fragmented hidden columns"
msgstr "அதிகமாக துண்டாக்கப்பட்ட மறைக்கப்பட்ட நெடுவரிசைகள் கடக்கப்பட்டன"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:468
msgid "No more data below"
msgstr "கீழே வேறு எந்த தரவும் இல்லை"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:475
msgid "No more data above"
msgstr "மேலே வேறு எந்த தரவும் இல்லை"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:482
msgid "No more data to the right"
msgstr "வலதுபுறம் வேறு எந்த தரவும் இல்லை"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:489
msgid "No more data to the left"
msgstr "இடதுபுறம் வேறு எந்த தரவும் இல்லை"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:552
msgid "Panes frozen"
msgstr "பலகங்கள் முடக்கப்பட்டன (Panes frozen)"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:554
msgid "Panes unfrozen"
msgstr "பலகங்கள் விடுவிக்கப்பட்டன (Panes unfrozen)"

#. -1 is xlSheetVisible
#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:577
#, python-brace-format
msgid "{sheet} hidden"
msgstr "{sheet} மறைக்கப்பட்டது"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:589
msgid "Sheet hidden"
msgstr "தாள் மறைக்கப்பட்டது"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:591
msgid "Sheet unhidden"
msgstr "தாள் வெளிப்படுத்தப்பட்டது"

#: addon\boa_lib\excel_enhancements\cell_navigation_tracker.py:774
#, python-brace-format
msgid "{address} {state}"
msgstr "{address} {state}"

#: addon\boa_lib\excel_enhancements\conditional_formatting.py:145
msgid "No active cell found."
msgstr "செயலில் உள்ள கலம் எதுவும் காணப்படவில்லை."

#: addon\boa_lib\excel_enhancements\conditional_formatting.py:151
msgid "No conditional formatting rules applied to this cell."
msgstr ""
"இந்த கலத்தில் எந்த நிபந்தனை வடிவமைப்பு விதிகளும் பயன்படுத்தப்படவில்லை."

#: addon\boa_lib\excel_enhancements\conditional_formatting.py:154
msgid "Failed to read format conditions."
msgstr "வடிவமைப்பு நிபந்தனைகளைப் படிக்க முடியவில்லை."

#: addon\boa_lib\excel_enhancements\conditional_formatting.py:296
msgid "Failed to analyze conditional formatting."
msgstr "நிபந்தனை வடிவமைப்பை பகுப்பாய்வு செய்ய முடியவில்லை."

#: addon\boa_lib\excel_enhancements\quick_sheet_mover.py:88
msgid "Only one sheet in workbook"
msgstr "பணிப்புத்தகத்தில் ஒரு தாள் மட்டுமே உள்ளது"

#: addon\boa_lib\excel_enhancements\quick_sheet_mover.py:93
#: addon\boa_lib\excel_enhancements\quick_sheet_mover.py:106
msgid "Already at beginning"
msgstr "ஏற்கனவே தொடக்கத்தில் உள்ளது"

#: addon\boa_lib\excel_enhancements\quick_sheet_mover.py:99
#: addon\boa_lib\excel_enhancements\quick_sheet_mover.py:112
msgid "Already at end"
msgstr "ஏற்கனவே முடிவில் உள்ளது"

#: addon\boa_lib\excel_enhancements\quick_sheet_mover.py:127
#, python-brace-format
msgid "Moved {sheet} to position {new_idx} of {total}"
msgstr "{sheet} ஆனது {total} இல் {new_idx} வது நிலைக்கு நகர்த்தப்பட்டது"

#: addon\boa_lib\excel_enhancements\quick_sheet_mover.py:130
