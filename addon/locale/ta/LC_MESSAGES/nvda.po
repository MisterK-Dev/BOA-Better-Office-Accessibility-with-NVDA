#. Title for the NVDA settings dialog list and the panel title
#: addon\boa_lib\boa_gui.py:33
msgid "BOA Office Enhancements"
msgstr "BOA Office மேம்பாடுகள்"

#: addon\boa_lib\boa_gui.py:65 addon\boa_lib\boa_gui.py:85
msgid "Off"
msgstr "முடக்கு"

#: addon\boa_lib\boa_gui.py:65
msgid "One-time Announcement"
msgstr "ஒருமுறை அறிவிப்பு"

#: addon\boa_lib\boa_gui.py:65
msgid "Guided Announcement"
msgstr "வழிகாட்டப்பட்ட அறிவிப்பு"

#: addon\boa_lib\boa_gui.py:85
msgid "Strict Memory Check (CountA)"
msgstr "கண்டிப்பான நினைவக சரிபார்ப்பு (CountA)"

#: addon\boa_lib\boa_gui.py:85
msgid "Visible Data Only (Math Engine)"
msgstr "புலப்படும் தரவு மட்டும் (Math Engine)"

#: addon\boa_lib\boa_gui.py:95
msgid "Select the engine used to detect the end of data in a row or column."
msgstr "ஒரு வரிசை அல்லது நெடுவரிசையில் தரவின் முடிவைக் கண்டறியப் பயன்படும் இன்ஜினைத் தேர்ந்தெடுக்கவும்."

#: addon\boa_lib\boa_gui.py:109
msgid "&Excel: Enable Bulk Sheet Organizer and Quick Sheet Mover"
msgstr "&Excel: Bulk Sheet Organizer மற்றும் Quick Sheet Mover ஆகியவற்றை இயக்கு"

#: addon\boa_lib\boa_gui.py:110
msgid "Use accessible Sheet &Rename dialog instead of native edit field"
msgstr "நேட்டிவ் எடிட் புலத்திற்குப் பதிலாக அணுகக்கூடிய தாள் மறுபெயரிடு (&R) உரையாடலைப் பயன்படுத்தவும்"

#: addon\boa_lib\boa_gui.py:111
msgid "Prevent NVDA &crashes in Excel text fields"
msgstr "Excel உரைப் புலங்களில் NVDA செயலிழப்பதைத் தடு (&c)"

#: addon\boa_lib\boa_gui.py:112
msgid "Announce when a m&ulti-cell selection is unexpectedly lost"
msgstr "பல-கலத் தேர்வு எதிர்பாராத விதமாக இழக்கப்படும்போது அறிவிக்கவும் (&u)"

#: addon\boa_lib\boa_gui.py:113
msgid "Proactively announce when navigating past &hidden rows or columns"
msgstr "மறைக்கப்பட்ட வரிசைகள் அல்லது நெடுவரிசைகளைக் கடந்து செல்லும் போது முன்கூட்டியே அறிவிக்கவும் (&h)"

#: addon\boa_lib\boa_gui.py:114
msgid "Enable Sheet &Layout Analyzer via NVDA+E, L"
msgstr "NVDA+E, L மூலம் Sheet &Layout Analyzer ஐ இயக்கு"

#: addon\boa_lib\boa_gui.py:115
msgid "Sheet Layout Auto-Announce &Mode:"
msgstr "தாள் லேஅவுட் தானியங்கு-அறிவிப்பு பயன்முறை (&M):"

#: addon\boa_lib\boa_gui.py:116
msgid "Conditional &Formatting and color"
msgstr "நிபந்தனை வடிவமைப்பு மற்றும் நிறம் (&F)"

#: addon\boa_lib\boa_gui.py:117
msgid "Enable Cell Moni&tor (slots 1-9 and continuous background monitoring)"
msgstr "கலக் கண்காணிப்பியை இயக்கு (ஸ்லாட்டுகள் 1-9 மற்றும் தொடர்ச்சியான பின்னணி கண்காணிப்பு) (&t)"

#: addon\boa_lib\boa_gui.py:118
msgid "Announce when there is no more data in the direction you are &navigating"
msgstr "நீங்கள் செல்லும் திசையில் வேறு தரவு இல்லாதபோது அறிவிக்கவும் (&n)"

#: addon\boa_lib\boa_gui.py:120
msgid "Excel Enhancements"
msgstr "Excel மேம்பாடுகள்"

#: addon\boa_lib\boa_gui.py:124
msgid "&PowerPoint: Read hidden Hex codes when navigating the Standard Color hexagon grid"
msgstr "&PowerPoint: ஸ்டாண்டர்ட் கலர் அறுகோண கட்டத்தில் செல்லும்போது மறைக்கப்பட்ட Hex குறியீடுகளைப் படிக்கவும்"

#: addon\boa_lib\boa_gui.py:125
msgid "Ensure the He&x Color edit field is properly labeled"
msgstr "He&x வண்ண திருத்து புலம் சரியாக லேபிளிடப்பட்டுள்ளதை உறுதிசெய்யவும்"

#: addon\boa_lib\boa_gui.py:126
msgid "Ensure the R&GB Color edit fields are properly labeled"
msgstr "R&GB வண்ண திருத்து புலங்கள் சரியாக லேபிளிடப்பட்டுள்ளதை உறுதிசெய்யவும்"

#: addon\boa_lib\boa_gui.py:127
msgid "Prevent NVDA cr&ashes in PowerPoint text fields"
msgstr "PowerPoint உரைப் புலங்களில் NVDA செயலிழப்பதைத் தடு (&a)"

#: addon\boa_lib\boa_gui.py:129
msgid "PowerPoint Enhancements"
msgstr "PowerPoint மேம்பாடுகள்"

#: addon\boa_lib\boa_gui.py:133
msgid "&Word: Prevent NVDA crashes in Word text fields"
msgstr "&Word: Word உரைப் புலங்களில் NVDA செயலிழப்பதைத் தடு"

#: addon\boa_lib\boa_gui.py:135
msgid "Word Enhancements"
msgstr "Word மேம்பாடுகள்"

