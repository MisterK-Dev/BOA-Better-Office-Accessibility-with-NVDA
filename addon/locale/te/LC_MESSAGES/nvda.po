msgstr "ఫ్లోటింగ్ వస్తువులు: {count} ఆకారం(లు)/చార్ట్(లు) ఉన్నాయి"

msgid "Pivot Tables: Contains {count} Pivot Table(s)"
msgstr "పివట్ టేబుల్స్: {count} పివట్ టేబుల్(లు) ఉన్నాయి"

msgid "View Mode: Page Break Preview"
msgstr "వీక్షణ మోడ్: పేజీ విరామ పరిదృశ్యం"

msgid "View Mode: Page Layout"
msgstr "వీక్షణ మోడ్: పేజీ లేఅవుట్"

