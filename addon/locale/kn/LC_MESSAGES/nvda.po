msgstr "ಘನೀಕೃತ ಪೇನ್‌ಗಳು: ಸಾಲುಗಳು 1-{r}, ಕಾಲಮ್‌ಗಳು A-{c}"

msgid "Frozen Panes: Rows 1-{r}"
msgstr "ಘನೀಕೃತ ಪೇನ್‌ಗಳು: ಸಾಲುಗಳು 1-{r}"

msgid "Frozen Panes: Columns A-{c}"
msgstr "ಘನೀಕೃತ ಪೇನ್‌ಗಳು: ಕಾಲಮ್‌ಗಳು A-{c}"

msgid "Frozen Panes: Active"
msgstr "ಘನೀಕೃತ ಪೇನ್‌ಗಳು: ಸಕ್ರಿಯವಾಗಿದೆ"

msgid "Floating Objects: Contains {count} Shape(s)/Chart(s)"
msgstr "ತೇಲುವ ವಸ್ತುಗಳು: {count} ಆಕಾರ(ಗಳು)/ಚಾರ್ಟ್(ಗಳು) ಒಳಗೊಂಡಿದೆ"

msgid "Pivot Tables: Contains {count} Pivot Table(s)"
msgstr "ಪಿವೋಟ್ ಟೇಬಲ್‌ಗಳು: {count} ಪಿವೋಟ್ ಟೇಬಲ್(ಗಳು) ಒಳಗೊಂಡಿದೆ"

msgid "View Mode: Page Break Preview"
msgstr "ವೀಕ್ಷಣೆ ಮೋಡ್: ಪುಟ ವಿರಾಮ ಪೂರ್ವವೀಕ್ಷಣೆ"

msgid "View Mode: Page Layout"
msgstr "ವೀಕ್ಷಣೆ ಮೋಡ್: ಪುಟ ಲೇಔಟ್"

