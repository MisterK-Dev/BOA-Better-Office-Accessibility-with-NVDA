"{props}"

msgid ""
"\n"
"\n"
"--- Sheet Properties ---\n"
"No special properties detected (No active filters, protection, frozen panes, or hidden borders)."
msgstr ""
"\n"
"\n"
"--- ಶೀಟ್ ಗುಣಲಕ್ಷಣಗಳು ---\n"
"ಯಾವುದೇ ವಿಶೇಷ ಗುಣಲಕ್ಷಣಗಳು ಕಂಡುಬಂದಿಲ್ಲ (ಯಾವುದೇ ಸಕ್ರಿಯ ಫಿಲ್ಟರ್‌ಗಳು, ರಕ್ಷಣೆ, ಘನೀಕೃತ ಪೇನ್‌ಗಳು ಅಥವಾ ಮರೆಮಾಡಲಾದ ಗಡಿಗಳಿಲ್ಲ)."

msgid ""
"## What's New in v1.6.1\n"
"* **Deep File Localization**: Fixed missing string translations deep within the Excel enhancement modules (such as the Sheet Layout Analyzer and Quick Sheet Mover) to ensure 100% localization coverage.\n"
"* **Expanded Translation Support**: Added 7 new languages to the system (Turkish, Polish, Korean, Ukrainian, Czech, Urdu, and Punjabi). \n"
"  *(Note: These translations were generated by AI, so some minor translation errors or inaccuracies may be present.)*"
msgstr ""
"## v1.6.1 ನಲ್ಲಿ ಹೊಸತೇನಿದೆ\n"
"* **ಡೀಪ್ ಫೈಲ್ ಲೋಕಲೈಸೇಶನ್**: 100% ಲೋಕಲೈಸೇಶನ್ ಕವರೇಜ್ ಅನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಲು ಎಕ್ಸೆಲ್ ಎನ್‌ಹ್ಯಾನ್ಸ್‌ಮೆಂಟ್ ಮಾಡ್ಯೂಲ್‌ಗಳ (ಶೀಟ್ ಲೇಔಟ್ ಅನಲೈಜರ್ ಮತ್ತು ಕ್ವಿಕ್ ಶೀಟ್ ಮೂವರ್) ಒಳಗೆ ಆಳವಾಗಿ ಕಾಣೆಯಾದ ಸ್ಟ್ರಿಂಗ್ ಅನುವಾದಗಳನ್ನು ಪರಿಹರಿಸಲಾಗಿದೆ.\n"
"* **ವಿಸ್ತರಿತ ಅನುವಾದ ಬೆಂಬಲ**: ಸಿಸ್ಟಮ್‌ಗೆ 7 ಹೊಸ ಭಾಷೆಗಳನ್ನು (ಟರ್ಕಿಶ್, ಪೋಲಿಷ್, ಕೊರಿಯನ್, ಉಕ್ರೇನಿಯನ್, ಜೆಕ್, ಉರ್ದು ಮತ್ತು ಪಂಜಾಬಿ) ಸೇರಿಸಲಾಗಿದೆ.\n"
"  *(ಗಮನಿಸಿ: ಈ ಅನುವಾದಗಳನ್ನು AI ನಿಂದ ರಚಿಸಲಾಗಿದೆ, ಆದ್ದರಿಂದ ಕೆಲವು ಸಣ್ಣ ಅನುವಾದ ದೋಷಗಳು ಅಥವಾ ತಪ್ಪುಗಳು ಇರಬಹುದು.)*"

msgid "BOA (Better Office Accessibility)"
msgstr "BOA (ಬೆಟರ್ ಆಫೀಸ್ ಆಕ್ಸೆಸಿಬಿಲಿಟಿ)"

msgid ""
"Triggers the BOA command prefix. Press this, followed by a specific command "
"key."
msgstr ""
"BOA ಕಮಾಂಡ್ ಪ್ರಿಫಿಕ್ಸ್ ಅನ್ನು ಪ್ರಚೋದಿಸುತ್ತದೆ. ಇದನ್ನು ಒತ್ತಿ, ನಂತರ ನಿರ್ದಿಷ್ಟ "
"ಕಮಾಂಡ್ ಕೀಲಿಯನ್ನು ಒತ್ತಿ."

msgid "Launches the Bulk Sheet Organizer dialog to reorder sheets."
msgstr ""
"ಶೀಟ್‌ಗಳನ್ನು ಮರುಕ್ರಮಗೊಳಿಸಲು ಬಲ್ಕ್ ಶೀಟ್ ಆರ್ಗನೈಸರ್ ಡೈಲಾಗ್ ಅನ್ನು "
"ಪ್ರಾರಂಭಿಸುತ್ತದೆ."

msgid "Analyzes and announces the layout structure of the current sheet."
msgstr "ಪ್ರಸ್ತುತ ಶೀಟ್‌ನ ಲೇಔಟ್ ರಚನೆಯನ್ನು ವಿಶ್ಲೇಷಿಸುತ್ತದೆ ಮತ್ತು ಪ್ರಕಟಿಸುತ್ತದೆ."

msgid "Jumps the focus to the nearest cell block."
msgstr "ಹತ್ತಿರದ ಸೆಲ್ ಬ್ಲಾಕ್‌ಗೆ ಫೋಕಸ್ ಅನ್ನು ಜಂಪ್ ಮಾಡುತ್ತದೆ."

msgid "Announces conditional formatting details for the current cell."
msgstr "ಪ್ರಸ್ತುತ ಸೆಲ್‌ಗಾಗಿ ಷರತ್ತುಬದ್ಧ ಫಾರ್ಮ್ಯಾಟಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರಕಟಿಸುತ್ತದೆ."

msgid "Toggles monitoring on the active cell."
msgstr "ಸಕ್ರಿಯ ಸೆಲ್‌ನಲ್ಲಿ ಮಾನಿಟರಿಂಗ್ ಅನ್ನು ಟಾಗಲ್ ಮಾಡುತ್ತದೆ."

msgid "Clears all monitored cells."
msgstr "ಎಲ್ಲಾ ಮಾನಿಟರ್ ಮಾಡಲಾದ ಸೆಲ್‌ಗಳನ್ನು ತೆರವುಗೊಳಿಸುತ್ತದೆ."

msgid ""
"Traces precedents and opens a dialog to jump to cells that provide data to "
"the active cell."
msgstr ""
"ಪೂರ್ವನಿದರ್ಶನಗಳನ್ನು ಪತ್ತೆಹಚ್ಚುತ್ತದೆ ಮತ್ತು ಸಕ್ರಿಯ ಸೆಲ್‌ಗೆ ಡೇಟಾವನ್ನು ಒದಗಿಸುವ "
"ಸೆಲ್‌ಗಳಿಗೆ ಜಂಪ್ ಮಾಡಲು ಡೈಲಾಗ್ ಅನ್ನು ತೆರೆಯುತ್ತದೆ."

msgid ""
"Traces dependents and opens a dialog to jump to cells that depend on the "
"active cell."
msgstr ""
"ಅವಲಂಬಿತಗಳನ್ನು ಪತ್ತೆಹಚ್ಚುತ್ತದೆ ಮತ್ತು ಸಕ್ರಿಯ ಸೆಲ್ ಅನ್ನು ಅವಲಂಬಿಸಿರುವ ಸೆಲ್‌ಗಳಿಗೆ"
" ಜಂಪ್ ಮಾಡಲು ಡೈಲಾಗ್ ಅನ್ನು ತೆರೆಯುತ್ತದೆ."

msgid "Announces the raw formula of the active cell."
msgstr "ಸಕ್ರಿಯ ಸೆಲ್‌ನ ಮೂಲ ಫಾರ್ಮುಲಾವನ್ನು ಪ್ರಕಟಿಸುತ್ತದೆ."

msgid ""
"Opens the accessible Power Editor dialog to edit the active cell's contents."
msgstr ""
"ಸಕ್ರಿಯ ಸೆಲ್‌ನ ವಿಷಯಗಳನ್ನು ಎಡಿಟ್ ಮಾಡಲು ಆಕ್ಸೆಸಿಬಲ್ ಪವರ್ ಎಡಿಟರ್ ಡೈಲಾಗ್ ಅನ್ನು "
"ತೆರೆಯುತ್ತದೆ."

msgid ""
"Opens the Active Cell Monitors dialog to manage and jump to monitored cells."
msgstr ""
"ಮಾನಿಟರ್ ಮಾಡಲಾದ ಸೆಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಲು ಮತ್ತು ಜಂಪ್ ಮಾಡಲು ಆಕ್ಟಿವ್ ಸೆಲ್ "
"ಮಾನಿಟರ್ಸ್ ಡೈಲಾಗ್ ಅನ್ನು ತೆರೆಯುತ್ತದೆ."

msgid ""
"Jumps focus back to the cell you were working on before navigating away."
msgstr ""
"ದೂರ ನ್ಯಾವಿಗೇಟ್ ಮಾಡುವ ಮೊದಲು ನೀವು ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತಿದ್ದ ಸೆಲ್‌ಗೆ ಫೋಕಸ್ ಅನ್ನು "
"ಹಿಂದಕ್ಕೆ ಜಂಪ್ ಮಾಡುತ್ತದೆ."

msgid "Launches the Bulk Slide Organizer dialog to reorder slides."
msgstr ""
"ಸ್ಲೈಡ್‌ಗಳನ್ನು ಮರುಕ್ರಮಗೊಳಿಸಲು ಬಲ್ಕ್ ಸ್ಲೈಡ್ ಆರ್ಗನೈಸರ್ ಡೈಲಾಗ್ ಅನ್ನು "
"ಪ್ರಾರಂಭಿಸುತ್ತದೆ."

msgid "Analyzes and announces the layout structure of the current slide."
msgstr ""
"ಪ್ರಸ್ತುತ ಸ್ಲೈಡ್‌ನ ಲೇಔಟ್ ರಚನೆಯನ್ನು ವಿಶ್ಲೇಷಿಸುತ್ತದೆ ಮತ್ತು ಪ್ರಕಟಿಸುತ್ತದೆ."

msgid ""
"Analyzes the current PowerPoint presentation and displays a comprehensive "
"layout and health report."
msgstr ""
"ಪ್ರಸ್ತುತ PowerPoint ಪ್ರಸ್ತುತಿಯನ್ನು ವಿಶ್ಲೇಷಿಸುತ್ತದೆ ಮತ್ತು ಸಮಗ್ರ ಲೇಔಟ್ ಮತ್ತು "
"ಆರೋಗ್ಯ ವರದಿಯನ್ನು ಪ್ರದರ್ಶಿಸುತ್ತದೆ."

msgid ""
"Analyzes the current Word document and displays a comprehensive layout and "
"health report."
msgstr ""
"ಪ್ರಸ್ತುತ Word ಡಾಕ್ಯುಮೆಂಟ್ ಅನ್ನು ವಿಶ್ಲೇಷಿಸುತ್ತದೆ ಮತ್ತು ಸಮಗ್ರ ಲೇಔಟ್ ಮತ್ತು "
"ಆರೋಗ್ಯ ವರದಿಯನ್ನು ಪ್ರದರ್ಶಿಸುತ್ತದೆ."

msgid ""
"Audits the current Word document for visual formatting inconsistencies."
msgstr ""
"ದೃಶ್ಯ ಫಾರ್ಮ್ಯಾಟಿಂಗ್ ಅಸಂಗತತೆಗಳಿಗಾಗಿ ಪ್ರಸ್ತುತ Word ಡಾಕ್ಯುಮೆಂಟ್ ಅನ್ನು ಆಡಿಟ್ "
"ಮಾಡುತ್ತದೆ."

msgid "Analysis cancelled."
msgstr "ವಿಶ್ಲೇಷಣೆ ರದ್ದುಗೊಂಡಿದೆ."

msgid "An error occurred during analysis."
msgstr "ವಿಶ್ಲೇಷಣೆ ಸಮಯದಲ್ಲಿ ದೋಷ ಸಂಭವಿಸಿದೆ."

msgid "Default NVDA Behavior (Reference Only)"
msgstr "ಡೀಫಾಲ್ಟ್ NVDA ನಡವಳಿಕೆ (ಉಲ್ಲೇಖಕ್ಕಾಗಿ ಮಾತ್ರ)"

msgid "Read Note Content Inline"
msgstr "ನೋಟ್ ಕಂಟೆಂಟ್ ಅನ್ನು ಇನ್‌ಲೈನ್‌ನಲ್ಲಿ ಓದಿ"

msgid ""
"Choose whether NVDA should automatically read the text of footnotes and "
"endnotes inline with the document text."
msgstr ""
"NVDA ಅಡಿಟಿಪ್ಪಣಿಗಳು ಮತ್ತು ಅಂತ್ಯಟಿಪ್ಪಣಿಗಳ ಪಠ್ಯವನ್ನು ಡಾಕ್ಯುಮೆಂಟ್ ಪಠ್ಯದೊಂದಿಗೆ "
"ಇನ್‌ಲೈನ್‌ನಲ್ಲಿ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಓದಬೇಕೆ ಎಂದು ಆಯ್ಕೆಮಾಡಿ."

msgid "Default NVDA Behavior"
msgstr "ಡೀಫಾಲ್ಟ್ NVDA ನಡವಳಿಕೆ"

msgid "Default Behavior + 3D Spatial Audio (Experimental)"
msgstr "ಡೀಫಾಲ್ಟ್ ನಡವಳಿಕೆ + 3D ಸ್ಪೇಷಿಯಲ್ ಆಡಿಯೋ (ಪ್ರಾಯೋಗಿಕ)"

msgid ""
"Controls how NVDA announces shape movement in PowerPoint. Canvas modes "
"translate raw math coordinates into human-readable locations like 'Top-Left "
"Quadrant'."
msgstr ""
"PowerPoint ನಲ್ಲಿ ಆಕಾರದ ಚಲನೆಯನ್ನು NVDA ಹೇಗೆ ಪ್ರಕಟಿಸುತ್ತದೆ ಎಂಬುದನ್ನು "
"ನಿಯಂತ್ರಿಸುತ್ತದೆ. ಕ್ಯಾನ್ವಾಸ್ ಮೋಡ್‌ಗಳು ಕಚ್ಚಾ ಗಣಿತದ ನಿರ್ದೇಶಾಂಕಗಳನ್ನು "
"'ಟಾಪ್-ಲೆಫ್ಟ್ ಕ್ವಾಡ್ರಾಂಟ್' ನಂತಹ ಮಾನವ-ಓದಬಲ್ಲ ಸ್ಥಳಗಳಿಗೆ ಅನುವಾದಿಸುತ್ತವೆ."

msgid "Prevent NVDA &crashes in Excel text fields (SafeRichEdit)"
msgstr ""
